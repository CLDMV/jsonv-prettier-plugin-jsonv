{
	"name": "@cldmv/prettier-plugin-jsonv",
	"version": "1.2.1",
	"description": "Prettier plugin for @cldmv/jsonv files",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./types/src/index.d.mts",
	"exports": {
		".": {
			"prettier-plugin-jsonv-dev": {
				"types": "./types/src/index.d.mts",
				"import": "./src/index.mjs",
				"require": "./src/index.cjs"
			},
			"types": "./types/src/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=22.22.0",
			"onFail": "error"
		}
	},
	"scripts": {
		"build": "tsup",
		"build:ci": "npm run lint --if-present && npm run format:check --if-present && npm run build && npm run test:types",
		"build:types": "tsc -p .configs/tsconfig.types.jsonc",
		"prepack": "npm run build",
		"test": "node tests/run-vitest.mjs && npm run test:dist",
		"test:dist": "npm run build && node --conditions=prettier-plugin-jsonv-dev --test tests/cjs/entry.test.cjs",
		"test:types": "npm run build:types && tsc -p tests/types/tsconfig.json",
		"test:watch": "vitest --config .configs/vitest.config.mjs",
		"coverage": "node tests/run-vitest.mjs --coverage-quiet",
		"ci:coverage": "npm run coverage && npm run test:dist",
		"lint": "eslint --config .configs/eslint.config.mjs .",
		"lint:fix": "eslint --config .configs/eslint.config.mjs . --fix",
		"format": "prettier --config .configs/.prettierrc --write .",
		"format:check": "prettier --config .configs/.prettierrc --check .",
		"prepare": "node -e \"import('./.githooks/install.mjs').catch(()=>{})\"",
		"fix:headers": "fix-headers --config .configs/fix-headers.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist/",
		"!dist/**/*.map",
		"types/"
	],
	"peerDependencies": {
		"@cldmv/jsonv": "^1.1.0",
		"prettier": "^3.0.0"
	},
	"devDependencies": {
		"@cldmv/configs": "^1.3.0",
		"@cldmv/eslint-plugin-jsonv": "^1.0.17",
		"@cldmv/fix-headers": "^2.2.4",
		"@cldmv/jsonv": "^1.1.5",
		"@cldmv/vitest-runner": "^1.5.6",
		"@eslint/css": "^2.0.1",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.1.0",
		"@eslint/markdown": "^8.0.3",
		"@vitest/coverage-v8": "^5.0.0",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.9.9",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.0"
	},
	"overrides": {
		"katex": ">=0.19.1 <1.0.0",
		"minimatch": "^11.0.3"
	},
	"keywords": [
		"prettier",
		"jsonv",
		"json5",
		"formatter",
		"code-style",
		"formatting",
		"es2015",
		"es2020",
		"es2021",
		"bigint",
		"numeric-separators"
	],
	"author": {
		"name": "Shinrai",
		"company": "CLDMV",
		"email": "git+npm@cldmv.net",
		"url": "https://cldmv.net"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/CLDMV/jsonv-prettier-plugin-jsonv.git"
	},
	"bugs": {
		"url": "https://github.com/CLDMV/jsonv-prettier-plugin-jsonv/issues"
	},
	"homepage": "https://github.com/CLDMV/jsonv-prettier-plugin-jsonv#readme",
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/shinrai"
	},
	"contributors": [
		{
			"name": "CLDMV",
			"url": "https://github.com/CLDMV"
		}
	]
}
