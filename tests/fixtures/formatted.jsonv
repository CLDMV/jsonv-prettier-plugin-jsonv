{
	host: "localhost",
	port: 8080,
	// connection settings
	database: {
		primary: {
			host: "db1.example.com",
			port: 5432
		},
		replica: {
			host: "db2.example.com",
			port: 5432
		}
	},
	url: `http://${host}:${port}`,
	/* endpoint list */
	endpoints: [
		"/api/v1",
		"/api/v2",
		"/health"
	],
	debug: false,
	timeout: 30000
}
