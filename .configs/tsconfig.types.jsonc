{
	"compilerOptions": {
		"allowJs": true,
		// Type-check the JSDoc, not just emit declarations from it: a type error
		// fails `build:types` (and so `build`, `test:types` and `build:ci`).
		"checkJs": true,
		"strict": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": true,
		"rootDir": "..",
		"outDir": ".././types",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"skipLibCheck": true,
		"stripInternal": true,
		"types": []
	},
	"include": ["../src/**/*.mjs"]
}
