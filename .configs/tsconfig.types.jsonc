{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"declarationMap": true,
		"rootDir": "..",
		"outDir": ".././types",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"skipLibCheck": true,
		"stripInternal": true
	},
	"include": ["../**/*.js", "../**/*.mjs", "../**/*.d.ts"],
	"exclude": [
		"../api_tests",
		"../api_test",
		"../tests",
		"../tools",
		"../coverage",
		"../tmp",
		"../types",
		"../.config",
		"../.configs",
		"../.data",
		"../dist",
		"../scripts",
		"../build",
		"../docs",
		"../node_modules",
		"../**/* copy.mjs",
		"../**/* copy*.mjs"
	]
}
